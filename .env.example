# Copy to .env and fill in. Restart `npx expo start` after changes.

# Supabase → Project Settings → API (the anon/publishable key is safe in the app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Cloud → Credentials → OAuth client ID of type "Web application"
# (the same one you pasted into Supabase → Auth → Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=XXXX.apps.googleusercontent.com

# Google Cloud → API key restricted to "Maps SDK for Android" + your app's SHA-1
GOOGLE_MAPS_ANDROID_KEY=YOUR-MAPS-KEY

# Shown on the Help button (WhatsApp), digits only with country code
EXPO_PUBLIC_SUPPORT_PHONE=919999999999

# From `eas init`
EAS_PROJECT_ID=
